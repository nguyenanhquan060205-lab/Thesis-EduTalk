# =============================================
# EduTalk Backend - Biến môi trường
# Copy file này thành .env và điền thông tin thật vào
# =============================================

# --- Firebase Admin SDK ---
# Lấy từ: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# Option 1: Dán nội dung file JSON vào đây (dùng khi deploy lên Render/Heroku)
FIREBASE_CREDENTIALS_JSON=

# Option 2: Đặt file serviceAccountKey.json vào thư mục backend/ (dùng khi chạy local)
# (Không cần điền biến này, chỉ cần có file)

# --- Firebase Web API Key ---
# Lấy từ: Firebase Console -> Project Settings -> General -> Web API Key
FIREBASE_WEB_API_KEY=AIzaSy...

# --- Gemini AI API Key ---
# Lấy từ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# --- Cloudinary (Upload ảnh bài viết) ---
# Lấy từ: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=edutalk-app
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- MoMo Payment (Đã có sẵn) ---
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# --- EmailJS (Gửi OTP qua email) ---
# Lấy từ: https://www.emailjs.com/
EMAILJS_SERVICE_ID=service_jz7he5o
EMAILJS_TEMPLATE_ID=template_ntv9o9c
EMAILJS_PUBLIC_KEY=Ezr_VkJnGkvD-1Ma0
